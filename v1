
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>NEON ARENA</title>
<style>
*{box-sizing:border-box}
body{
 margin:0;background:#050711;color:white;
 font-family:Arial,sans-serif;overflow:hidden;
 display:flex;justify-content:center;align-items:center;
 height:100vh
}
#game{
 position:relative;width:min(100vw,1000px);
 height:min(100vh,650px);background:#080d1d;
 border:2px solid #14d9ff;overflow:hidden;
 box-shadow:0 0 35px #00cfff44
}
canvas{width:100%;height:100%;display:block}
#hud{position:absolute;top:12px;left:15px;right:15px;
 display:flex;justify-content:space-between;pointer-events:none;
 text-shadow:0 0 10px cyan;font-weight:bold}
#overlay{
 position:absolute;inset:0;background:#030614dd;
 display:flex;flex-direction:column;align-items:center;
 justify-content:center;text-align:center;padding:20px
}
h1{font-size:clamp(35px,7vw,70px);color:#00eaff;
 text-shadow:0 0 25px #00dfff;margin:10px}
p{color:#b8d9ed;line-height:1.6}
button{
 background:#00dfff;color:#00101a;border:0;
 padding:15px 30px;font-weight:bold;font-size:17px;
 cursor:pointer;border-radius:5px;margin:10px;
 box-shadow:0 0 20px #00dfff66
}
button:hover{background:white}
#mobile{
 position:absolute;bottom:15px;left:0;right:0;
 display:none;justify-content:space-between;padding:0 15px
}
#mobile button{opacity:.7;padding:16px}
@media(pointer:coarse){#mobile{display:flex}}
</style>
</head>
<body>
<div id="game">
 <canvas id="c" width="1000" height="650"></canvas>
 <div id="hud">
  <span id="stats">❤️ 100 | ⭐ 0</span>
  <span id="wave">VAGUE 1</span>
  <span id="level">NIVEAU 1</span>
 </div>
 <div id="overlay">
  <h1>NEON ARENA</h1>
  <p>PROTOCOL: SURVIVAL<br>
  Survis aux vagues ennemies.<br>
  Deviens plus puissant. Détruis le boss.</p>
  <p>⌨️ ZQSD / WASD : déplacement<br>
  🖱️ Souris : viser et tirer<br>
  ESPACE : tir rapide</p>
  <button onclick="start()">LANCER LA PARTIE</button>
  <small>Un seul survivant peut gagner.</small>
 </div>
 <div id="mobile">
  <button id="left">◀</button>
  <button id="shoot">🔥</button>
  <button id="right">▶</button>
 </div>
</div>
<script>
const c=document.getElementById("c"),ctx=c.getContext("2d");
const W=1000,H=650;
let player,enemies=[],bullets=[],particles=[],keys={};
let running=false,score=0,wave=1,xp=0,level=1;
let spawn=0,shoot=0,boss=null,mouse={x:700,y:300};
let upgrades=[];

function start(){
 player={x:500,y:325,hp:100,max:100,speed:4,damage:25,
  fire:0,radius:15};
 enemies=[];bullets=[];particles=[];
 score=0;wave=1;xp=0;level=1;spawn=0;boss=null;
 running=true;
 document.getElementById("overlay").style.display="none";
}
function enemy(){
 let side=Math.floor(Math.random()*4),x,y;
 if(side===0){x=0;y=Math.random()*H}
 else if(side===1){x=W;y=Math.random()*H}
 else if(side===2){x=Math.random()*W;y=0}
 else{x=Math.random()*W;y=H}
 let type=Math.random();
 let e={
  x,y,r:13,hp:35+wave*8,speed:1+Math.random()*1.1+wave*.08,
  color:"#ff315e",damage:8,value:10,type:"normal",attack:0
 };
 if(type>.75){
  e.r=22;e.hp*=2.5;e.speed*=.65;
  e.color="#ff9d24";e.damage=15;e.value=25;e.type="tank";
 }
 if(type>.94){
  e.r=11;e.hp*=.8;e.speed*=1.7;
  e.color="#bd4dff";e.damage=7;e.value=20;e.type="fast";
 }
 enemies.push(e);
}
function burst(x,y,color,n=8){
 for(let i=0;i<n;i++){
  let a=Math.random()*Math.PI*2,s=Math.random()*5;
  particles.push({x,y,vx:Math.cos(a)*s,vy:Math.sin(a)*s,
   life:25,color});
 }
}
function fire(){
 if(!running||player.fire>0)return;
 let a=Math.atan2(mouse.y-player.y,mouse.x-player.x);
 bullets.push({x:player.x,y:player.y,
  vx:Math.cos(a)*10,vy:Math.sin(a)*10,
  damage:player.damage,life:90});
 player.fire=11;
 burst(player.x,player.y,"#00eaff",2);
}
function spawnBoss(){
 boss={x:500,y:70,r:38,hp:500+wave*100,
  max:500+wave*100,fire:0,speed:1.5};
}
function update(){
 if(!running)return;
 let dx=(keys.d||keys.ArrowRight?1:0)-(keys.q||keys.a||keys.ArrowLeft?1:0);
 let dy=(keys.s||keys.ArrowDown?1:0)-(keys.z||keys.w||keys.ArrowUp?1:0);
 let l=Math.hypot(dx,dy)||1;
 player.x=Math.max(15,Math.min(W-15,player.x+dx/l*player.speed));
 player.y=Math.max(15,Math.min(H-15,player.y+dy/l*player.speed));
 if(player.fire>0)player.fire--;
 if(keys[" "]||keys.shoot)fire();

 if(++spawn>Math.max(15,65-wave*3)){
  enemy();spawn=0;
 }
 if(!boss&&wave%5===0&&enemies.length===0)spawnBoss();

 for(let e of enemies){
  let a=Math.atan2(player.y-e.y,player.x-e.x);
  e.x+=Math.cos(a)*e.speed;
  e.y+=Math.sin(a)*e.speed;
  if(Math.hypot(player.x-e.x,player.y-e.y)<player.radius+e.r){
   player.hp-=e.damage*.025;
  }
 }
 for(let b of bullets){
  b.x+=b.vx;b.y+=b.vy;b.life--;
  for(let e of enemies){
   if(e.hp>0&&Math.hypot(b.x-e.x,b.y-e.y)<e.r){
    e.hp-=b.damage;b.life=0;
    burst(b.x,b.y,e.color,4);
    if(e.hp<=0){
     score+=e.value;xp+=e.value;
     burst(e.x,e.y,e.color,15);
    }
   }
  }
  if(boss&&Math.hypot(b.x-boss.x,b.y-boss.y)<boss.r){
   boss.hp-=b.damage;b.life=0;
   burst(b.x,b.y,"#ff00cc",4);
  }
 }
 bullets=bullets.filter(b=>b.life>0&&b.x>=0&&b.x<=W&&b.y>=0&&b.y<=H);
 enemies=enemies.filter(e=>e.hp>0);
 if(boss){
  let a=Math.atan2(player.y-boss.y,player.x-boss.x);
  boss.x+=Math.cos(a)*boss.speed;
  boss.y+=Math.sin(a)*boss.speed;
  if(++boss.fire>65){
   let angle=Math.atan2(player.y-boss.y,player.x-boss.x);
   for(let i=-1;i<=1;i++){
    bulletsEnemy.push({x:boss.x,y:boss.y,
     vx:Math.cos(angle+i*.3)*4,vy:Math.sin(angle+i*.3)*4});
   }
   boss.fire=0;
  }
  if(boss.hp<=0){
   score+=500;xp+=200;burst(boss.x,boss.y,"#ff00cc",80);
   boss=null;wave++;
  }
 }
 for(let b of bulletsEnemy){
  b.x+=b.vx;b.y+=b.vy;
  if(Math.hypot(b.x-player.x,b.y-player.y)<player.radius+5){
   player.hp-=.6;b.dead=true;
  }
 }
 bulletsEnemy=bulletsEnemy.filter(b=>!b.dead&&b.x>0&&b.x<W&&b.y>0&&b.y<H);
 for(let p of particles){
  p.x+=p.vx;p.y+=p.vy;p.life--;
 }
 particles=particles.filter(p=>p.life>0);
 if(xp>=level*100){
  xp-=level*100;level++;
  player.damage+=5;player.max+=10;player.hp=Math.min(player.max,player.hp+30);
  showUpgrade();
 }
 if(enemies.length===0&&!boss&&wave%5!==0&&spawn===0)wave++;
 if(player.hp<=0){endGame();return}
 document.getElementById("stats").textContent=
  "❤️ "+Math.ceil(player.hp)+" | ⭐ "+score;
 document.getElementById("wave").textContent="VAGUE "+wave;
 document.getElementById("level").textContent="NIVEAU "+level;
}
let bulletsEnemy=[];
function showUpgrade(){
 running=false;
 const o=document.getElementById("overlay");
 o.style.display="flex";
 o.innerHTML="<h1>NIVEAU "+level+" !</h1><p>CHOISIS TON AMÉLIORATION</p>";
 let choices=[
  ["⚡ VITESSE +1","player.speed+=1"],
  ["💥 DÉGÂTS +15","player.damage+=15"],
  ["❤️ SOIN +40","player.hp=Math.min(player.max,player.hp+40)"],
  ["🔥 CADENCE + rapide","player.fire=Math.max(0,player.fire-3);player.damage+=5"]
 ];
 choices.sort(()=>Math.random()-.5);
 for(let [name,code] of choices.slice(0,3)){
  let b=document.createElement("button");b.textContent=name;
  b.onclick=()=>{eval(code);o.style.display="none";running=true};
  o.appendChild(b);
 }
}
function endGame(){
 running=false;
 const o=document.getElementById("overlay");
 o.style.display="flex";
 o.innerHTML=`<h1>GAME OVER</h1>
 <p>Score : ${score}<br>Niveau : ${level}<br>Vague : ${wave}</p>
 <button onclick="start()">REJOUER</button>`;
}
function draw(){
 ctx.fillStyle="#080d1d";ctx.fillRect(0,0,W,H);
 ctx.strokeStyle="#14243b";ctx.lineWidth=1;
 for(let x=0;x<W;x+=40){ctx.beginPath();ctx.moveTo(x,0);ctx.lineTo(x,H);ctx.stroke()}
 for(let y=0;y<H;y+=40){ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(W,y);ctx.stroke()}
 for(let p of particles){
  ctx.globalAlpha=p.life/25;ctx.fillStyle=p.color;
  ctx.fillRect(p.x,p.y,4,4);
 }
 ctx.globalAlpha=1;
 for(let e of enemies){
  ctx.shadowBlur=15;ctx.shadowColor=e.color;
  ctx.fillStyle=e.color;ctx.beginPath();
  ctx.arc(e.x,e.y,e.r,0,7);ctx.fill();
  ctx.shadowBlur=0;
 }
 for(let b of bullets){
  ctx.fillStyle="#00ffff";ctx.shadowBlur=12;ctx.shadowColor="cyan";
  ctx.beginPath();ctx.arc(b.x,b.y,5,0,7);ctx.fill();
 }
 for(let b of bulletsEnemy){
  ctx.fillStyle="#ff3399";ctx.beginPath();ctx.arc(b.x,b.y,6,0,7);ctx.fill();
 }
 if(boss){
  ctx.fillStyle="#ff00cc";ctx.shadowBlur=30;ctx.shadowColor="#ff00cc";
  ctx.beginPath();ctx.arc(boss.x,boss.y,boss.r,0,7);ctx.fill();
  ctx.shadowBlur=0;ctx.fillStyle="#fff";
  ctx.fillRect(350,25,300,12);
  ctx.fillStyle="#ff00cc";
  ctx.fillRect(350,25,300*Math.max(0,boss.hp/boss.max),12);
 }
 if(player){
  ctx.shadowBlur=25;ctx.shadowColor="#00eaff";
  ctx.fillStyle="#00eaff";ctx.beginPath();
  ctx.arc(player.x,player.y,player.radius,0,7);ctx.fill();
  ctx.shadowBlur=0;
  ctx.strokeStyle="white";ctx.lineWidth=3;
  ctx.beginPath();ctx.arc(player.x,player.y,player.radius+4,0,7);ctx.stroke();
  ctx.fillStyle="#fff";ctx.fillRect(15,H-20,player.hp/player.max*180,8);
  ctx.strokeStyle="#00eaff";ctx.strokeRect(15,H-20,180,8);
 }
}
function loop(){update();draw();requestAnimationFrame(loop)}
document.addEventListener("keydown",e=>keys[e.key]=true);
document.addEventListener("keyup",e=>keys[e.key]=false);
c.addEventListener("mousemove",e=>{
 let r=c.getBoundingClientRect();
 mouse.x=(e.clientX-r.left)*W/r.width;
 mouse.y=(e.clientY-r.top)*H/r.height;
});
c.addEventListener("mousedown",()=>fire());
document.getElementById("shoot").onpointerdown=()=>keys.shoot=true;
document.getElementById("shoot").onpointerup=()=>keys.shoot=false;
document.getElementById("left").onpointerdown=()=>keys.q=true;
document.getElementById("left").onpointerup=()=>keys.q=false;
document.getElementById("right").onpointerdown=()=>keys.d=true;
document.getElementById("right").onpointerup=()=>keys.d=false;
loop();
</script>
</div>
</body>
</html>
